{
  "name": "perchance-as-a-service",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade uncertainty over HTTP.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler-preview.log wrangler dev --config dist/server/wrangler.json --port 8787",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler-types.log wrangler types",
    "deploy:dry-run": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler-dry-run.log wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler-deploy.log wrangler deploy --config dist/server/wrangler.json",
    "audit:production": "npm audit --omit=dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
